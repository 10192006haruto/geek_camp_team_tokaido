# 開発用の設定例。このファイルをコピーして .env.local を作り、値を書き換えてください。
# .env.local は Git で除外されています。このファイルには実際のキーを書かないでください。
# サーバー専用の値なので、NEXT_PUBLIC_ は付けません。

# 店舗データの取得元：mock（架空データ・外部通信なし）または places（Google Places + Gemini）
# 未設定の場合、開発中は mock、本番（NODE_ENV=production）では 503 を返します。
RESTAURANT_DATA_SOURCE=mock

# places のときに必要（Places API (New) を有効にしたキー）
GOOGLE_PLACES_API_KEY=your-google-places-api-key

# places のときに必要（レビューからの料理抽出）
GEMINI_API_KEY=your-gemini-api-key

# 省略時は gemini-3.5-flash-lite
# GEMINI_MODEL=gemini-3.5-flash-lite
